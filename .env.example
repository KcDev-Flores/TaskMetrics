# Supabase: Dashboard -> Project Settings -> API / API Keys
# Si las tres variables están definidas, el sistema usa Supabase. Si falta alguna,
# arranca en modo local (SQLite), pensado solo para desarrollo.
SUPABASE_URL=https://your-project-ref.supabase.co
# Llave pública 'anon' / publishable: solo se usa para iniciar y refrescar sesión
SUPABASE_KEY=
# Llave secreta 'service_role' / secret: lectura y escritura de datos y gestión de
# cuentas. Vive solo en el servidor; nunca la pongas en el navegador ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# Servidor web (en un despliegue usa HOST=0.0.0.0 y el PORT que indique el proveedor)
HOST=127.0.0.1
PORT=8000
METRICS_PRECISION=4

# Estudio y áreas (cada líder evalúa solo a su área; el admin ve todas)
STUDIO_NAME=Café Estudio
AREAS=diseñador,blockbench,builder,doblaje

# Se entra con nombre de usuario, sin correo. Supabase Auth exige uno, así que cada
# cuenta se registra allí como <usuario>@<este dominio>. No lo cambies una vez
# creadas las cuentas: dejarían de poder entrar.
LOGIN_EMAIL_DOMAIN=usuarios.taskmetrics.local

# Solo modo local: administrador inicial que se crea si no hay usuarios
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin123
