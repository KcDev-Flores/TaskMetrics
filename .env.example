# Supabase Project Configuration
# Encuentra estos valores en: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Llave pública 'anon' / publishable key para autenticación y llamadas seguras con RLS
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Llave secreta 'service_role' para operaciones administrativas de usuarios (Solo Backend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Servidor Web
HOST=127.0.0.1
PORT=8000
METRICS_PRECISION=4
